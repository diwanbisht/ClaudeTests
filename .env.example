# Application under test
BASE_URL=https://the-internet.herokuapp.com
UI_WEB_APP_URL=http://localhost:5500

# Jira Cloud (requirement source)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Xray for Jira Cloud (manual test case store)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=

# Claude / Anthropic (test generation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Chroma + Ollama (local vector DB + local LLM for local RAG experiments —
# src/rag/*, not part of CI)
# Start Chroma with: chroma run --path ./chroma-data (or a Docker container)
CHROMA_HOST=localhost
CHROMA_PORT=8000
# Ollama must be running locally with these models pulled:
#   ollama pull nomic-embed-text
#   ollama pull llama3
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GENERATE_MODEL=llama3

# MySQL (test data)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=test_automation

# GitHub (MCP server)
GITHUB_PAT=

# Notifications (npm run notify) — optional, no-op if left blank.
# Slack: create an Incoming Webhook at https://api.slack.com/messaging/webhooks
# Teams: create a Workflow/Incoming Webhook connector on the target channel
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Logging
LOG_LEVEL=info

# Playwright retries (default: 2 in CI, 1 locally). Override to tune flakiness handling.
# TEST_RETRIES=1
