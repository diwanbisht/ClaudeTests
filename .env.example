# Application under test
BASE_URL=https://the-internet.herokuapp.com
UI_WEB_APP_URL=http://localhost:5500

# Jira Cloud (requirement source)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Xray for Jira Cloud (manual test case store)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=

# Claude / Anthropic (test generation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# MySQL (test data)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=test_automation

# GitHub (MCP server)
GITHUB_PAT=

# Logging
LOG_LEVEL=info

# Playwright retries (default: 2 in CI, 1 locally). Override to tune flakiness handling.
# TEST_RETRIES=1
